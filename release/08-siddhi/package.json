{
  "name": "siddhi",
  "displayName": "Siddhi \u2014 Coding Achievement System",
  "description": "A local coding achievement system tracking real observable events. Achievements are based on actual activity: first builds, tests, debug sessions, git commits, refactors, and passing test suites. No fabrication of achievements. No mandatory cloud account. Local-only progress and history.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "achievements",
    "gamification",
    "milestones",
    "tracking",
    "local",
    "progress"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions",
    "directory": "packages/siddhi"
  },
  "bugs": {
    "url": "https://github.com/kanak-prabhakar/vscode-extensions/issues"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "siddhi.viewAchievements",
        "title": "Siddhi: View Achievements",
        "category": "Siddhi"
      },
      {
        "command": "siddhi.resetProgress",
        "title": "Siddhi: Reset Progress",
        "category": "Siddhi"
      },
      {
        "command": "siddhi.exportHistory",
        "title": "Siddhi: Export History",
        "category": "Siddhi"
      }
    ],
    "configuration": {
      "title": "Siddhi",
      "properties": {
        "siddhi.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Siddhi coding achievement system"
        },
        "siddhi.achievements.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show achievement unlock notifications"
        },
        "siddhi.progress.resetOnNewWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Reset progress on new workspace detection"
        },
        "siddhi.privacy.localOnly": {
          "type": "boolean",
          "default": true,
          "description": "Keep all data local, no cloud sync"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "siddhi.viewAchievements",
          "when": "siddhi.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "siddhi.viewAchievements",
          "group": "siddhi",
          "when": "siddhi.enabled"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  },
  "publisher": "kanak-prabhakar"
}