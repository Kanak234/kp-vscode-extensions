{
  "name": "vivida",
  "displayName": "Vivida \u2014 Humorous Diagnostics",
  "description": "Entertaining explanations for programming errors. Displays humorous explanations alongside technical diagnostics and possible fixes. The actual technical diagnostic remains always visible.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "diagnostics",
    "humor",
    "errors",
    "explanations",
    "programming"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions",
    "directory": "packages/vivida"
  },
  "bugs": {
    "url": "https://github.com/kanak-prabhakar/vscode-extensions/issues"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vivida.diagnose",
        "title": "Vivida: Show Humorous Diagnosis",
        "category": "Vivida"
      },
      {
        "command": "vivida.toggleHumor",
        "title": "Vivida: Toggle Humor",
        "category": "Vivida"
      }
    ],
    "configuration": {
      "title": "Vivida",
      "properties": {
        "vivida.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Vivida humorous diagnostics"
        },
        "vivida.humor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable humorous explanations"
        },
        "vivida.humor.reduceMotion": {
          "type": "boolean",
          "default": false,
          "description": "Reduce motion for accessibility"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vivida.diagnose",
          "when": "vivida.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "vivida.diagnose",
          "group": "vivida",
          "when": "vivida.enabled"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  },
  "publisher": "kanak-prabhakar"
}