{
  "name": "kp-avalokana",
  "displayName": "KP Avalokana \u2014 Code Metrics Inspector",
  "description": "Real-time cyclomatic complexity, code debt, and visual metrics analyzer.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "avalokana",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "avalokana.analyzeMetrics",
        "title": "Avalokana: Analyze Code Metrics",
        "category": "Avalokana"
      },
      {
        "command": "avalokana.openDashboard",
        "title": "Avalokana: Open Dashboard",
        "category": "Avalokana"
      }
    ],
    "configuration": {
      "title": "Avalokana",
      "properties": {
        "avalokana.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Avalokana features"
        },
        "avalokana.maxComplexity": {
          "type": "number",
          "default": 15,
          "description": "Configuration setting for maxComplexity"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
