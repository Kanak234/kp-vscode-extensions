{
  "name": "kp-ganitha",
  "displayName": "KP Ganitha \u2014 Math & Algorithm Solver",
  "description": "Symbolic math computation, algorithm step tracer, and numerical solver.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ganitha",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ganitha.evaluateExpression",
        "title": "Ganitha: Evaluate Expression",
        "category": "Ganitha"
      },
      {
        "command": "ganitha.openDashboard",
        "title": "Ganitha: Open Dashboard",
        "category": "Ganitha"
      }
    ],
    "configuration": {
      "title": "Ganitha",
      "properties": {
        "ganitha.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ganitha features"
        },
        "ganitha.precision": {
          "type": "number",
          "default": 10,
          "description": "Configuration setting for precision"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
