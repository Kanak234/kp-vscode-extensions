{
  "name": "kp-anumana",
  "displayName": "KP Anumana \u2014 AI Code Inference",
  "description": "Lightweight AI-assisted code inference, type prediction, and logic checking.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "anumana",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anumana.infer",
        "title": "Anumana: Infer Code Logic",
        "category": "Anumana"
      },
      {
        "command": "anumana.openDashboard",
        "title": "Anumana: Open Dashboard",
        "category": "Anumana"
      }
    ],
    "configuration": {
      "title": "Anumana",
      "properties": {
        "anumana.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anumana features"
        },
        "anumana.confidenceThreshold": {
          "type": "number",
          "default": 80,
          "description": "Configuration setting for confidenceThreshold"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
