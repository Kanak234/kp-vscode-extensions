{
  "name": "kp-sambandha",
  "displayName": "KP Sambandha \u2014 Peer Collaboration Engine",
  "description": "Peer-to-peer live workspace sharing and pair programming session manager.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sambandha",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sambandha.startSession",
        "title": "Sambandha: Start Collaboration Session",
        "category": "Sambandha"
      },
      {
        "command": "sambandha.openDashboard",
        "title": "Sambandha: Open Dashboard",
        "category": "Sambandha"
      }
    ],
    "configuration": {
      "title": "Sambandha",
      "properties": {
        "sambandha.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Sambandha features"
        },
        "sambandha.roomCode": {
          "type": "string",
          "default": "",
          "description": "Configuration setting for roomCode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
