{
  "name": "kp-pariksha",
  "displayName": "KP Pariksha \u2014 Test Automation Suite",
  "description": "Automated test runner, assertion generator, and coverage report viewer.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pariksha",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pariksha.runTests",
        "title": "Pariksha: Run Pariksha Test Suite",
        "category": "Pariksha"
      },
      {
        "command": "pariksha.openDashboard",
        "title": "Pariksha: Open Dashboard",
        "category": "Pariksha"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pariksha",
          "title": "Pariksha"
        }
      ]
    },
    "views": {
      "pariksha": [
        {
          "type": "tree",
          "id": "pariksha.testExplorer",
          "name": "Test Explorer"
        }
      ]
    },
    "configuration": {
      "title": "Pariksha",
      "properties": {
        "pariksha.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Pariksha features"
        },
        "pariksha.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Configuration setting for autoRun"
        },
        "pariksha.testPatterns": {
          "type": "array",
          "default": [
            "**/*.test.ts",
            "**/*.spec.ts",
            "**/*_test.py"
          ],
          "description": "Glob patterns to detect test files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
