{
  "name": "kp-vritti",
  "displayName": "KP Vritti \u2014 Live Developer Activity",
  "description": "A live developer dashboard showing available, non-sensitive local metrics such as active editor, running tasks, extension activity, build status, test status, and debug state. Unavailable metrics show 'UNAVAILABLE' rather than invented data.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dashboard",
    "activity",
    "metrics",
    "developer",
    "status",
    "live"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions",
    "directory": "packages/vritti"
  },
  "bugs": {
    "url": "https://github.com/kanak-prabhakar/vscode-extensions/issues"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vritti.showDashboard",
        "title": "Vritti: Show Dashboard",
        "category": "Vritti"
      },
      {
        "command": "vritti.refreshMetrics",
        "title": "Vritti: Refresh Metrics",
        "category": "Vritti"
      }
    ],
    "configuration": {
      "title": "Vritti",
      "properties": {
        "vritti.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Vritti live developer activity"
        },
        "vritti.metrics.activeEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show active editor status"
        },
        "vritti.metrics.runningTasks": {
          "type": "boolean",
          "default": true,
          "description": "Show running tasks"
        },
        "vritti.metrics.extensionActivity": {
          "type": "boolean",
          "default": true,
          "description": "Show extension activity"
        },
        "vritti.metrics.buildStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show build status"
        },
        "vritti.metrics.testStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show test status"
        },
        "vritti.metrics.debugState": {
          "type": "boolean",
          "default": true,
          "description": "Show debug state"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vritti.showDashboard",
          "when": "vritti.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "vritti.showDashboard",
          "group": "vritti",
          "when": "vritti.enabled"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  },
  "publisher": "KANAKPRABHAKAR"
}
