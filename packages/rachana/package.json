{
  "name": "kp-rachana",
  "displayName": "KP Rachana \u2014 Project Scaffolding",
  "description": "Instant CS laboratory template generator and boilerplate scaffolder.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rachana",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rachana.createProject",
        "title": "Rachana: Create Project Scaffold",
        "category": "Rachana"
      },
      {
        "command": "rachana.openDashboard",
        "title": "Rachana: Open Dashboard",
        "category": "Rachana"
      }
    ],
    "configuration": {
      "title": "Rachana",
      "properties": {
        "rachana.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Rachana features"
        },
        "rachana.templateDir": {
          "type": "string",
          "default": "templates",
          "description": "Configuration setting for templateDir"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
