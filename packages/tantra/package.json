{
  "name": "kp-tantra",
  "displayName": "KP Tantra \u2014 Code Generation Engine",
  "description": "Boilerplate, data structure, and API wrapper generator.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tantra",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tantra.generateCode",
        "title": "Tantra: Generate Code Snippet",
        "category": "Tantra"
      },
      {
        "command": "tantra.openDashboard",
        "title": "Tantra: Open Dashboard",
        "category": "Tantra"
      }
    ],
    "configuration": {
      "title": "Tantra",
      "properties": {
        "tantra.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Tantra features"
        },
        "tantra.language": {
          "type": "string",
          "default": "cpp",
          "description": "Configuration setting for language"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
