{
  "name": "kp-samvada",
  "displayName": "KP Samvada \u2014 Contextual AI Assistant",
  "description": "Interactive inline assistant for coding questions, debugging, and hints.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "samvada",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "samvada.openChat",
        "title": "Samvada: Open Contextual Chat",
        "category": "Samvada"
      },
      {
        "command": "samvada.openDashboard",
        "title": "Samvada: Open Dashboard",
        "category": "Samvada"
      }
    ],
    "configuration": {
      "title": "Samvada",
      "properties": {
        "samvada.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Samvada features"
        },
        "samvada.modelName": {
          "type": "string",
          "default": "antigravity-local",
          "description": "Configuration setting for modelName"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
