{
  "name": "kp-darshana",
  "displayName": "KP Darshana \u2014 AST & Graph Visualizer",
  "description": "AST graph visualizer and dependency tree inspector for programming languages.",
  "version": "1.0.0",
  "publisher": "KANAKPRABHAKAR",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "darshana",
    "kanak-prabhakar",
    "vs-code-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kanak-prabhakar/vscode-extensions"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "darshana.showAst",
        "title": "Darshana: Show AST Graph",
        "category": "Darshana"
      },
      {
        "command": "darshana.openDashboard",
        "title": "Darshana: Open Dashboard",
        "category": "Darshana"
      }
    ],
    "configuration": {
      "title": "Darshana",
      "properties": {
        "darshana.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Darshana features"
        },
        "darshana.graphLayout": {
          "type": "string",
          "default": "hierarchical",
          "description": "Configuration setting for graphLayout"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --skip-license",
    "clean": "rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@kanak-prabhakar/shared": "workspace:*"
  }
}
